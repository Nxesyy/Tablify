// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN_SPACE
}

model User {
  id          Int          @id @default(autoincrement())
  username    String       @unique @db.VarChar(255)
  password    String       @db.VarChar(255)
  role        Role         @default(MEMBER)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  member      Member?
  space_owner Space_owner?

  @@map("users")
}

model Member {
  id          Int      @id @default(autoincrement())
  nama_member String   @db.VarChar(255)
  Instansi    String   @db.VarChar(255)
  alamat      String
  telp        String   @db.VarChar(255)
  id_user     Int      @unique
  foto        String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user             User               @relation(fields: [id_user], references: [id])
  Reservasi        Reservasi[]
  detailReservasis detail_reservasi[]
  reviews          Review[]

  @@map("members")
}

model Space_owner {
  id             Int      @id @default(autoincrement())
  nama_coworking String   @db.VarChar(255)
  nama_pemilik   String   @db.VarChar(255)   
  telp           String   @db.VarChar(255)
  alamat         String?  @db.Text
  id_user        Int      @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user      User        @relation(fields: [id_user], references: [id])
  space     Space[]
  reservasi Reservasi[]
  diskons   Diskon[]

  @@map("space_owners")
}

enum Tipe {
  DESK
  MEETING_ROOM
  PRIVATE_OFFICE
}

model Space {
  id            Int      @id @default(autoincrement())
  nama_space    String   @db.VarChar(255)
  harga_per_jam Float
  tipe          Tipe
  kapasitas     Int
  foto          String?  @db.Text
  deskripsi     String
  id_owner      Int
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  owner            Space_owner        @relation(fields: [id_owner], references: [id])
  detail_reservasi detail_reservasi[]
  reviews          Review[]

  @@map("spaces")
}

enum Status {
  Belum_Dikonfirmasi
  Disetujui
  aktif
  selesai
  dibatalkan
}

model Reservasi {
  id                Int       @id @default(autoincrement())
  kode_tiket        String?   @unique @db.VarChar(50)
  tanggal_reservasi DateTime
  jam_mulai         DateTime
  jam_selesai       DateTime?
  durasi_jam        Int
  id_owner          Int
  id_member         Int
  status            Status    @default(Belum_Dikonfirmasi)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  space_owner     Space_owner       @relation(fields: [id_owner], references: [id])
  member          Member            @relation(fields: [id_member], references: [id])
  detailReservasi detail_reservasi?
  review          Review?

  @@map("reservasis")
}

model detail_reservasi {
  id            Int    @id @default(autoincrement())
  id_reservasi  Int    @unique
  id_space      Int
  id_member     Int
  id_diskon     Int?
  tarif_per_jam Float?
  total_jam     Int?
  subtotal      Float?
  potongan      Float? @default(0)
  total_harga   Float

  reservasi Reservasi @relation(fields: [id_reservasi], references: [id], onDelete: Cascade)
  member    Member    @relation(fields: [id_member], references: [id])
  diskon    Diskon?   @relation(fields: [id_diskon], references: [id])
  space     Space?    @relation(fields: [id_space], references: [id])

  @@map("detail_reservasis")
}

model Diskon {
  id                Int               @id @default(autoincrement())
  kode_diskon       String?           @db.VarChar(50)
  nama_diskkon      String            @db.VarChar(255)
  presentase_diskon Float
  tanggal_awal      DateTime
  tanggal_akhir     DateTime
  id_owner          Int?
  owner             Space_owner?      @relation(fields: [id_owner], references: [id])
  detailReservasis  detail_reservasi[]

  @@map("diskons")
}

model Review {
  id           Int        @id @default(autoincrement())
  id_space     Int
  id_member    Int
  id_reservasi Int        @unique
  rating       Int
  komentar     String     @db.Text
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  space        Space      @relation(fields: [id_space], references: [id], onDelete: Cascade)
  member       Member     @relation(fields: [id_member], references: [id], onDelete: Cascade)
  reservasi    Reservasi  @relation(fields: [id_reservasi], references: [id], onDelete: Cascade)

  @@map("reviews")
}
